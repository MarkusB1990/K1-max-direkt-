{"commands": [
  {"command": "parameters.add", "params": {"name": "blech_d", "expression": "4 mm", "comment": "Dicke der umgebogenen Blechkante (mit Schublehre messen)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "klemm", "expression": "0.6 mm", "comment": "Vorspannung: so viel enger als das Blech ist der Clip an der Klemmstelle (mehr = haelt fester)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "tiefe", "expression": "15 mm", "comment": "Wie weit der Clip auf das Blech geschoben wird", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "t", "expression": "2.5 mm", "comment": "Staerke der Schenkel"}},
  {"command": "parameters.add", "params": {"name": "tb", "expression": "3 mm", "comment": "Staerke des Bodens"}},
  {"command": "parameters.add", "params": {"name": "breite", "expression": "10 mm", "comment": "Breite des Clips (Druckhoehe)"}},
  {"command": "parameters.add", "params": {"name": "kabel_r", "expression": "1.8 mm", "comment": "Radius Kabelaufnahme (1.8 mm = fuer 3-mm-Kabel)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "haken_ende", "expression": "59 deg", "comment": "Bis zu diesem Winkel schliesst sich die Kabelaufnahme (59 deg = ca. 2,1 mm Spalt oben)"}},
  {"command": "parameters.add", "params": {"name": "w0", "expression": "(blech_d + 0.4 mm) / 2", "comment": "halbe Schlitzbreite am Boden (etwas Luft)"}},
  {"command": "parameters.add", "params": {"name": "w1", "expression": "(blech_d - klemm) / 2", "comment": "halbe Schlitzbreite an der Klemmstelle"}},
  {"command": "parameters.add", "params": {"name": "tief", "expression": "tb + 5 mm", "comment": "Mitte Kabelaufnahme unter dem Schlitzboden"}},
  {"command": "parameters.add", "params": {"name": "kx", "expression": "w0 + t + kabel_r", "comment": "Mitte Kabelaufnahme (x)"}},
  {"command": "parameters.add", "params": {"name": "L", "expression": "40 mm", "comment": "Hilfsmass fuer Schnitte"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Klemme"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["-(w0 + t)", "-tb"], ["w0 + t", "-tb"], ["w0 + t", "tiefe"], ["w1 + 1 mm", "tiefe"], ["w1", "tiefe - 2.5 mm"], ["w0", 0], ["-w0", 0], ["-w1", "tiefe - 2.5 mm"], ["-(w1 + 1 mm)", "tiefe"], ["-(w0 + t)", "tiefe"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Klemme", "body_name": "Blechclip"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r + t"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Kabelaufnahme", "body_name": "Kabelaufnahme"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["kx", "-tief"], ["kx + L * cos(haken_ende)", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "name": "Kabelaufnahme oeffnen", "targets": ["Kabelaufnahme"]}},
  {"command": "solid.combine", "params": {"target": "Blechclip", "tools": ["Kabelaufnahme"], "operation": "join", "touching": "one_body"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Steg"}},
  {"command": "sketch.rectangle.two_point", "params": {"p0": ["w0", "-tief"], "p1": ["w0 + t", "-tb / 2"]}},
  {"command": "sketch.circle.center", "params": {"center": ["kx + (kabel_r + t / 2) * cos(haken_ende)", "-tief + (kabel_r + t / 2) * sin(haken_ende)"], "radius": "t / 2"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "join", "name": "Steg", "targets": ["Blechclip"], "touching": "one_body"}}
]}
