{"commands": [
  {"command": "parameters.add", "params": {"name": "wulst_d", "expression": "20 mm", "comment": "Durchmesser Rinnenwulst (mit Messschieber messen)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "spiel", "expression": "0.6 mm", "comment": "Spiel zwischen Wulst und Haken", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "untergriff", "expression": "40 deg", "comment": "Wie weit der Haken vorne unter den Wulst greift (mehr = fester)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "t", "expression": "3 mm", "comment": "Materialstaerke"}},
  {"command": "parameters.add", "params": {"name": "breite", "expression": "10 mm", "comment": "Breite des Hakens (Druckhoehe)"}},
  {"command": "parameters.add", "params": {"name": "bein", "expression": "14 mm", "comment": "Bein innen in der Rinne: Laenge unter Wulstmitte minus R"}},
  {"command": "parameters.add", "params": {"name": "abhang", "expression": "12 mm", "comment": "Kabel haengt so weit unter der Unterkante des Wulsts"}},
  {"command": "parameters.add", "params": {"name": "kabel_r", "expression": "3.5 mm", "comment": "Radius Kabelaufnahme (3.5 mm = Kabel bis ca. 6 mm)"}},
  {"command": "parameters.add", "params": {"name": "haken_ende", "expression": "85 deg", "comment": "Bis zu diesem Winkel schliesst sich die Kabelaufnahme: 85 deg laesst oben ca. 2,4 mm Spalt, das Kabel rastet ein und kann bei Wind nicht herausrutschen"}},
  {"command": "parameters.add", "params": {"name": "R", "expression": "wulst_d / 2 + spiel", "comment": "Innenradius Buegel"}},
  {"command": "parameters.add", "params": {"name": "Rm", "expression": "R + t / 2", "comment": "Mittellinie Buegel"}},
  {"command": "parameters.add", "params": {"name": "tief", "expression": "R + abhang", "comment": "Mitte Kabelaufnahme unter Wulstmitte"}},
  {"command": "parameters.add", "params": {"name": "kx", "expression": "R + t + kabel_r", "comment": "Mitte Kabelaufnahme (x)"}},
  {"command": "parameters.add", "params": {"name": "L", "expression": "3 * wulst_d", "comment": "Hilfsmass fuer Schnitte"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Buegel"}},
  {"command": "sketch.circle.center", "params": {"center": [0, 0], "radius": "R + t"}},
  {"command": "sketch.circle.center", "params": {"center": [0, 0], "radius": "R"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Buegel", "body_name": "Dachrinnen-Haken"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Buegel oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [[0, 0], ["-L", 0], ["-L", "-L"], ["L * cos(untergriff)", "-L"], ["L * cos(untergriff)", "-L * sin(untergriff)"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "targets": ["Dachrinnen-Haken"], "name": "Buegel oeffnen"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r + t"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Kabelaufnahme", "body_name": "Kabelaufnahme"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["kx", "-tief"], ["kx + L * cos(haken_ende)", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "targets": ["Kabelaufnahme"], "name": "Kabelaufnahme oeffnen"}},
  {"command": "solid.combine", "params": {"target": "Dachrinnen-Haken", "tools": ["Kabelaufnahme"], "operation": "join", "touching": "one_body"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Stege"}},
  {"command": "sketch.rectangle.two_point", "params": {"p0": ["-R - t", "-R - bein"], "p1": ["-R", 0]}},
  {"command": "sketch.circle.center", "params": {"center": ["-Rm", "-R - bein"], "radius": "t / 2"}},
  {"command": "sketch.rectangle.two_point", "params": {"p0": ["R", "-tief"], "p1": ["R + t", 0]}},
  {"command": "sketch.circle.center", "params": {"center": ["Rm * cos(untergriff)", "-Rm * sin(untergriff)"], "radius": "t / 2"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx + (kabel_r + t / 2) * cos(haken_ende)", "-tief + (kabel_r + t / 2) * sin(haken_ende)"], "radius": "t / 2"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "join", "touching": "one_body", "targets": ["Dachrinnen-Haken"], "name": "Stege"}}
]}
