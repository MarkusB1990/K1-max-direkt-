{"commands": [
  {"command": "parameters.add", "params": {"name": "draht_d", "expression": "5 mm", "comment": "Dicke EINES waagerechten Drahts (mit Schublehre messen)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "gesamt_b", "expression": "15 mm", "comment": "Gesamtbreite ueber beide waagerechten Draehte (mit Schublehre messen)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "spiel", "expression": "0.5 mm", "comment": "Spiel um die Draehte (bei dicker Beschichtung etwas mehr)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "untergriff", "expression": "50 deg", "comment": "Wie weit der Buegel unter die Draehte greift (mehr = fester)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "t", "expression": "2.5 mm", "comment": "Materialstaerke"}},
  {"command": "parameters.add", "params": {"name": "breite", "expression": "10 mm", "comment": "Breite des Hakens (Druckhoehe), muss zwischen zwei senkrechte Staebe passen"}},
  {"command": "parameters.add", "params": {"name": "abhang", "expression": "10 mm", "comment": "Kabel haengt so weit unter der Unterkante der Draehte"}},
  {"command": "parameters.add", "params": {"name": "kabel_r", "expression": "3.5 mm", "comment": "Radius Kabelaufnahme (3.5 mm = Kabel bis ca. 6 mm)"}},
  {"command": "parameters.add", "params": {"name": "haken_ende", "expression": "85 deg", "comment": "Bis zu diesem Winkel schliesst sich die Kabelaufnahme (85 deg = ca. 2,4 mm Spalt oben)"}},
  {"command": "parameters.add", "params": {"name": "R", "expression": "draht_d / 2 + spiel", "comment": "Innenradius um einen Draht"}},
  {"command": "parameters.add", "params": {"name": "Rm", "expression": "R + t / 2", "comment": "Mittellinie"}},
  {"command": "parameters.add", "params": {"name": "a", "expression": "(gesamt_b - draht_d) / 2", "comment": "Abstand Drahtmitte von Mattenmitte"}},
  {"command": "parameters.add", "params": {"name": "tief", "expression": "R + abhang", "comment": "Mitte Kabelaufnahme unter Drahtmitte"}},
  {"command": "parameters.add", "params": {"name": "kx", "expression": "a + R + t + kabel_r", "comment": "Mitte Kabelaufnahme (x)"}},
  {"command": "parameters.add", "params": {"name": "L", "expression": "4 * (a + R)", "comment": "Hilfsmass fuer Schnitte"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Bogen vorne"}},
  {"command": "sketch.circle.center", "params": {"center": ["a", 0], "radius": "R + t"}},
  {"command": "sketch.circle.center", "params": {"center": ["a", 0], "radius": "R"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Bogen vorne", "body_name": "Zaunhaken"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Bogen vorne oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["a", 0], ["a", "L"], ["a - L", "L"], ["a - L", "-L"], ["a + L * cos(untergriff)", "-L"], ["a + L * cos(untergriff)", "-L * sin(untergriff)"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "name": "Bogen vorne oeffnen", "targets": ["Zaunhaken"]}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Bogen hinten"}},
  {"command": "sketch.circle.center", "params": {"center": ["-a", 0], "radius": "R + t"}},
  {"command": "sketch.circle.center", "params": {"center": ["-a", 0], "radius": "R"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Bogen hinten", "body_name": "Bogen hinten"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Bogen hinten oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["-a", 0], ["-a", "L"], ["-a + L", "L"], ["-a + L", "-L"], ["-a - L * cos(untergriff)", "-L"], ["-a - L * cos(untergriff)", "-L * sin(untergriff)"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "name": "Bogen hinten oeffnen", "targets": ["Bogen hinten"]}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r + t"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx", "-tief"], "radius": "kabel_r"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "new", "name": "Kabelaufnahme", "body_name": "Kabelaufnahme"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Kabelaufnahme oeffnen"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["kx", "-tief"], ["kx + L * cos(haken_ende)", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief + L * sin(haken_ende)"], ["kx - L", "-tief"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "cut", "name": "Kabelaufnahme oeffnen", "targets": ["Kabelaufnahme"]}},
  {"command": "solid.combine", "params": {"target": "Zaunhaken", "tools": ["Bogen hinten", "Kabelaufnahme"], "operation": "join", "touching": "one_body"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Stege"}},
  {"command": "sketch.rectangle.two_point", "params": {"p0": ["-a", "R"], "p1": ["a", "R + t"]}},
  {"command": "sketch.rectangle.two_point", "params": {"p0": ["a + R", "-tief"], "p1": ["a + R + t", 0]}},
  {"command": "sketch.circle.center", "params": {"center": ["a + Rm * cos(untergriff)", "-Rm * sin(untergriff)"], "radius": "t / 2"}},
  {"command": "sketch.circle.center", "params": {"center": ["-a - Rm * cos(untergriff)", "-Rm * sin(untergriff)"], "radius": "t / 2"}},
  {"command": "sketch.circle.center", "params": {"center": ["kx + (kabel_r + t / 2) * cos(haken_ende)", "-tief + (kabel_r + t / 2) * sin(haken_ende)"], "radius": "t / 2"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "breite", "operation": "join", "name": "Stege", "targets": ["Zaunhaken"], "touching": "one_body"}}
]}
