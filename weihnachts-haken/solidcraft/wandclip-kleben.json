{"commands": [
  {"command": "parameters.add", "params": {"name": "kabel_d", "expression": "5.2 mm", "comment": "Innendurchmesser Clip (= dickstes Kabel, das passt)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "oeffnung", "expression": "2.6 mm", "comment": "Breite der Einrast-Oeffnung (kleiner als das Kabel = haelt bei Wind)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "platte_b", "expression": "24 mm", "comment": "Breite der Grundplatte", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "platte_h", "expression": "40 mm", "comment": "Hoehe der Grundplatte (an der Wand)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "platte_t", "expression": "4 mm", "comment": "Dicke der Grundplatte"}},
  {"command": "parameters.add", "params": {"name": "wand", "expression": "2 mm", "comment": "Wandstaerke des Clips (duenner = laesst sich leichter einclipsen)", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "clip_b", "expression": "10 mm", "comment": "Laenge des Clips entlang des Kabels", "favorite": true}},
  {"command": "parameters.add", "params": {"name": "sockel", "expression": "1.5 mm", "comment": "Abstand Clip zur Platte"}},
  {"command": "parameters.add", "params": {"name": "kehle", "expression": "2 mm", "comment": "Hohlkehle am Uebergang Platte/Clip"}},
  {"command": "parameters.add", "params": {"name": "fase", "expression": "1.2 mm", "comment": "Einfuehrschraege an der Oeffnung"}},
  {"command": "parameters.add", "params": {"name": "Ri", "expression": "kabel_d / 2", "comment": "Innenradius Clip"}},
  {"command": "parameters.add", "params": {"name": "Ro", "expression": "Ri + wand", "comment": "Aussenradius Clip"}},
  {"command": "parameters.add", "params": {"name": "yc", "expression": "platte_h / 2", "comment": "Lage des Clips auf der Platte (Mitte, von unten)"}},
  {"command": "parameters.add", "params": {"name": "zc", "expression": "platte_t + sockel + Ro", "comment": "Abstand Clip-Mitte von der Wand"}},
  {"command": "parameters.add", "params": {"name": "zn", "expression": "zc + sqrt(Ri * Ri - oeffnung * oeffnung / 4)", "comment": "Hoehe der engsten Stelle der Oeffnung"}},
  {"command": "sketch.create", "params": {"plane": "XY", "name": "Grundplatte"}},
  {"command": "sketch.rectangle.rounded", "params": {"p0": [0, 0], "p1": ["platte_b", "platte_h"], "radius": "3 mm"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "platte_t", "operation": "new", "name": "Grundplatte", "body_name": "Wandclip"}},
  {"command": "sketch.create", "params": {"plane": "YZ", "offset": "(platte_b - clip_b) / 2", "name": "Clip"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["yc - Ro - kehle", "platte_t"], ["yc + Ro + kehle", "platte_t"], ["yc + Ro", "platte_t + kehle"], ["yc + Ro", "zc"], ["yc - Ro", "zc"], ["yc - Ro", "platte_t + kehle"]]}},
  {"command": "sketch.circle.center", "params": {"center": ["yc", "zc"], "radius": "Ro"}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "clip_b", "operation": "join", "touching": "one_body", "targets": ["Wandclip"], "name": "Clip"}},
  {"command": "sketch.create", "params": {"plane": "YZ", "offset": "(platte_b - clip_b) / 2", "name": "Kabelloch mit Oeffnung"}},
  {"command": "sketch.circle.center", "params": {"center": ["yc", "zc"], "radius": "Ri"}},
  {"command": "sketch.line", "params": {"closed": true, "points": [["yc - oeffnung / 2", "zc"], ["yc + oeffnung / 2", "zc"], ["yc + oeffnung / 2", "zn + 0.4 mm"], ["yc + oeffnung / 2 + fase", "zc + Ro + 0.5 mm"], ["yc - oeffnung / 2 - fase", "zc + Ro + 0.5 mm"], ["yc - oeffnung / 2", "zn + 0.4 mm"]]}},
  {"command": "sketch.finish", "params": {}},
  {"command": "solid.extrude", "params": {"distance": "clip_b", "operation": "cut", "targets": ["Wandclip"], "name": "Kabelloch mit Oeffnung"}}
]}
